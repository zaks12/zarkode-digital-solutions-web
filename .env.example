# ──────────────────────────────────────────────
# Contact form email delivery
# ──────────────────────────────────────────────

# Email address that enquiry notifications are sent TO.
# This is where you receive customer submissions.
CONTACT_TO_EMAIL=info@zarkode.com.ng

# Email address that enquiries are sent FROM.
# Must be a verified sender in your Resend account.
# Use a Zarkode domain email (e.g. noreply@zarkode.com.ng) once your
# domain is verified. Until then, Resend provides a default sandbox sender:
FROM_EMAIL=onboarding@resend.dev

# Resend API key — get yours at https://resend.com/api-keys
# Do NOT put the real key in this file. Set it in your deployment
# environment variables or .env (which is git-ignored).
RESEND_API_KEY=
